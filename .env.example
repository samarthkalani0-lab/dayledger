# Copy this file to .env.local and fill in the values. NEVER commit .env.local.

# Neon (Connect button in the Neon dashboard)
DATABASE_URL="postgresql://USER:PASS@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASS@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Auth.js  (make a secret with:  npx auth secret   or   openssl rand -base64 32)
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Google Cloud / Vertex AI (photo check)
GCP_PROJECT_ID=""
GCP_LOCATION="us-central1"
VERTEX_MODEL="gemini-2.5-flash"
# Only needed on Vercel (keyless login):
GCP_PROJECT_NUMBER=""
GCP_SERVICE_ACCOUNT_EMAIL=""
GCP_WORKLOAD_IDENTITY_POOL_ID="vercel"
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID="vercel"
